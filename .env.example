# Single env file for the whole repo. install-deps.sh / pnpm setup:env prepares it.
# Known HaalKhata public IDs are prefilled. Supply secrets yourself; existing
# values are preserved; secret fields are grouped at the bottom on every run.
#
#   docker compose  reads this file directly (substitution + env_file)
#   pnpm dev        loads it before starting Next.js
#   pnpm dev:mobile loads only EXPO_PUBLIC_* values before starting Expo
#
# Real shell variables always win over this file, so a one-off
# `DATABASE_URL=... pnpm dev` still overrides what is set here.
#
# In production prefer Docker secrets over a plaintext .env for anything
# secret — SESSION_SECRET, POSTGRES_PASSWORD and COMPATIBLE_AI_API_KEY.

# --- Database ------------------------------------------------------------
# Host development uses these non-secret parts and POSTGRES_PASSWORD below;
# the server URL-encodes the password, so it only needs to be entered once.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=haalkhata
POSTGRES_DB=haalkhata

# --- Auth ----------------------------------------------------------------
# Where server-local dev state lives (the generated session secret).
# Defaults to ./data; set only if you want it elsewhere.
# HAALKHATA_DATA_DIR=

# Trust X-Forwarded-For/X-Real-IP only when a front proxy overwrites them.
# Keep false for direct/local serving. The production Caddy stack sets true
# beside its security-critical header overwrite.
TRUST_PROXY_HEADERS=false

# ACME account contact for production certificate expiry/problem notices.
# Required by docker-compose.prod.yml. In production the deploy pipeline
# writes it from the ACME_EMAIL repository secret (see deploy.yml); set it
# here only when bootstrapping without the release workflow.
ACME_EMAIL=

# Production image tag. The deploy steps manage this as an exact Git commit
# SHA; set it manually only when bootstrapping without the release workflow.
IMAGE_TAG=

# Google sign-in. Create an OAuth client of type "Web application" in the
# Google Cloud Console and paste the SAME client id into both variables: the
# server uses it as the audience an ID token must name, the browser needs it
# to render Google's button. Left blank, the button is simply not rendered
# and the password form still works.
#
# NEITHER IS SECRET, and no client secret belongs in this file. The ID-token
# flow verifies a signed assertion against Google's public keys and never
# calls Google's token endpoint, so there is nothing to authenticate with. A
# client secret is only needed to act on a user's behalf against a Google API
# (Gmail, Drive, Contacts) — a different flow that this app does not use.
#
# Console setup: add every origin the button loads on (http://localhost:3000
# for dev, plus the production origin) under "Authorized JavaScript origins",
# and leave the redirect URIs empty — this flow never redirects. Publish the
# app too; in Testing it only admits the ≤100 listed test users. Publishing
# needs no Google review, because openid/email/profile are non-sensitive.
GOOGLE_CLIENT_ID=949728091152-ho59ulbgp6og5bu4cng3ue15ahu67n1h.apps.googleusercontent.com
#
# Same value. NEXT_PUBLIC_* is inlined into the client bundle at BUILD time
# rather than read at runtime, so the Docker image must be BUILT with this
# set — compose passes it through as a build arg (see docker-compose.yml).
# Setting it only at runtime leaves the button permanently hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=949728091152-ho59ulbgp6og5bu4cng3ue15ahu67n1h.apps.googleusercontent.com
#
# The mobile app signs in with native OAuth clients of its own — one Android
# client (package com.haalkhata.app + the signing key's SHA-1) and one iOS
# client (bundle com.haalkhata.app), created in the same Google Cloud project.
# An ID token names the client that requested it as its audience, so the
# server must accept these ids too. Comma separated; public like the web id.
GOOGLE_MOBILE_CLIENT_IDS=949728091152-sjq732amm2u8dmi2odhkbl6sbbaoaddp.apps.googleusercontent.com
# Apple sign-in works locally with real Apple credentials, just like Google.
# See docs/local-auth.md for browser, Android, and signed iOS development builds.
# Enable the capability on com.haalkhata.app. The .p8 key must be authorized
# for that App ID; use the same Team ID and Key ID that created the key.
APPLE_TEAM_ID=QL3M3QZSHQ
APPLE_KEY_ID=6XVYVH8478
# Browser/Android only: group this Services ID with the primary App ID.
# Setting this shows the Apple button on the web, like Google's client ID.
APPLE_SERVICE_ID=com.haalkhata.web
# Optional legacy prefix if the App ID prefix differs from the Team ID.
APPLE_APP_ID_PREFIX=
# SHA-256 signing fingerprints, colon-separated bytes; comma-separated for multiple keys.
ANDROID_SHA256_CERTIFICATES=
SUPPORT_EMAIL=haalkhata@protonmail.com
# Optional human-readable processor names; update whenever AI routing changes.
RECEIPT_AI_PROCESSORS=OpenRouter and Google (Gemini)
# Browser/Android Apple sign-in needs a registered HTTPS development origin
# pointing to THIS local server. Open the website at that origin too.
# Apple does not allow a localhost/IP callback. Native iOS needs no callback.
# Production Compose explicitly sets this to https://haalkhata.app.
APP_PUBLIC_URL=
# Apple private-key and encryption settings are in the secrets section below.
# APPLE_SIGN_IN_REQUIRED=true
# Apple browser return URL: <APP_PUBLIC_URL>/api/auth/apple/callback
# dev.sh checks this automatically; --mobile-ios selects native configuration.
# Optional diagnostic only: pnpm auth:check / pnpm auth:check --ios.
#
# Local Expo commands load these public values from THIS root .env. Native
# prebuild: pnpm --filter @haalkhata/mobile run expo prebuild. EAS cloud builds
# still use their EAS environment variables; no server secrets belong there.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=949728091152-sjq732amm2u8dmi2odhkbl6sbbaoaddp.apps.googleusercontent.com
# Optional local API origin. Omit to derive port 3000 from Metro's host.
# Use your local HTTPS tunnel for physical devices and Apple browser testing.
# EXPO_PUBLIC_API_URL=https://your-development-domain.example

# Phone ownership verification. Create a Twilio Verify Service and a restricted
# API key with Verify permissions. A phone number is never written or merged
# unless Verify returns an approved code check; missing configuration fails
# closed and leaves phone features unavailable.
TWILIO_API_KEY_SID=
TWILIO_VERIFY_SERVICE_SID=

# --- AI receipt parsing --------------------------------------------------
# Comma-separated failover order. Available: compatible, mock
# `mock` last keeps the scan flow demoable with no keys at all.
RECEIPT_AI_PROVIDERS=compatible,mock

# The only real provider: any endpoint speaking the OpenAI /chat/completions
# wire format. Production is OpenRouter, which fronts every model worth using
# here behind one key — there is no provider-specific SDK in the codebase.
COMPATIBLE_AI_BASE_URL=https://openrouter.ai/api/v1

# REQUIRED for this provider to activate — with no model set it stays inactive
# and the chain falls through to mock.
#
# Chosen on PRICE/PERFORMANCE across all 16 ZDR-eligible providers on
# OpenRouter (343 models -> 224 ZDR -> 100 with vision + structured outputs),
# scored on Roboflow Vision Evals. Receipts need both axes, so score below is
# mean(Data Extraction, OCR).
#
# Efficient frontier — each row beats everything cheaper:
#
#   $/receipt  score  extract   ocr   $ per extra point  model
#    0.00154   81.40   78.3%   84.5%        base         qwen/qwen3.5-27b
#    0.00184   87.35   86.6%   88.1%      $0.00005       qwen/qwen3-vl-235b-a22b-instruct
#    0.00245   89.05   90.7%   87.4%      $0.00036       google/gemini-3.5-flash-lite
#    0.00315   92.25   96.9%   87.6%      $0.00022       google/gemini-3-flash-preview  <- chosen
#    0.00945   92.95   94.8%   91.1%      $0.00900       google/gemini-3.5-flash
#    0.01260   93.70   94.8%   92.6%      $0.00420       google/gemini-3.1-pro-preview
#
# The cliff is right after this model: the next point of quality costs
# $0.00900 versus $0.00022 to reach here — 41x worse marginal value. It also
# has the HIGHEST extraction score on the entire board (96.9%), beating models
# costing 17x more, and extraction is our task.
#
# Everything pricier is dominated on mean score: claude-opus-4.8 ($0.02750)
# and claude-sonnet-5 ($0.01100) both score 90.70, below this model's 92.25;
# gpt-5.5 ($0.03150) scores 89.40; kimi-k3 ($0.01650) 88.75.
#
# Trade-off accepted: OCR is 87.6% (mid-pack) while extraction is best-in-class.
# The reconciliation check catches misread digits, and the escalation tier is
# picked specifically for OCR strength.
#
# Escalation: anthropic/claude-sonnet-5 ($0.01100, 91.7% OCR) — targets exactly
# this model's weak axis, from a different vendor so failures decorrelate.
# NOT claude-opus-4.8 ($0.02750, 93.8% OCR): 2.5x the price for 2.1 OCR points.
#
# ~$2.40/month at 500 scans with 15% escalating. GA-only alternative if preview
# status is unacceptable: google/gemini-3.5-flash-lite ($0.00245, score 89.05).
#
# ZDR eligibility is per ENDPOINT, not per model: qwen/qwen3-vl-32b-instruct is
# on OpenRouter but NOT ZDR-eligible. anthropic/claude-fable-5 has the board's
# best OCR (94.0%) and is unusable — it requires 30-day retention.
COMPATIBLE_AI_MODEL=google/gemini-3-flash-preview

# Request zero data retention: routes only to endpoints holding a
# zero-retention policy. Receipt images are never stored by HaalKhata, so this
# hop is the entire privacy surface. Belt and braces: also enforce ZDR
# account-wide in OpenRouter, which fails closed if a request omits the flag.
COMPATIBLE_AI_ZDR=true

# --- Secrets (fill these in) ----------------------------------------------

# Keep passwords, private keys, and API secrets in this bottom section.
# Public client IDs, Team/Key IDs, URLs, and other settings belong above.
# A secret can instead use <NAME>_FILE=/path/to/file; the file takes precedence.
# Production uses CI-managed Docker secret mounts, not these local values.
# Never give a secret an EXPO_PUBLIC_ or NEXT_PUBLIC_ prefix.
# Database password: use the existing password if the database already exists.
# Changing this value does not rotate the password stored in the db volume.
POSTGRES_PASSWORD=

# Optional full connection string: overrides the database parts above.
# Remote connections require ?sslmode=verify-full. Compose overrides its host.
DATABASE_URL=

# Session signing: at least 32 decoded bytes; generate with openssl rand -hex 32.
# Required in production. Optional locally: a key is persisted under data/.secret.
SESSION_SECRET=

# Optional planned rotation: retain the old signing key until sessions expire.
# Leave blank for a suspected exposure, so sessions using the old key end.
SESSION_SECRET_PREVIOUS=

# Local setup maintains the absolute path to root AppleAuthKey.p8.
# Paste your original .p8 contents into that file, including BEGIN/END lines.
# Existing file contents are never overwritten. The path itself is not secret.
APPLE_PRIVATE_KEY_FILE=

# Apple refresh-token encryption: generate once with openssl rand -hex 32.
# Retain this key for the database; do not regenerate it on each setup.
# Alternative: APPLE_TOKEN_ENCRYPTION_KEY_FILE=/absolute/path/to/key-file
APPLE_TOKEN_ENCRYPTION_KEY=

# Optional phone verification: the secret for TWILIO_API_KEY_SID above.
TWILIO_API_KEY_SECRET=

# Optional real receipt AI: the API key for COMPATIBLE_AI_BASE_URL above.
COMPATIBLE_AI_API_KEY=
