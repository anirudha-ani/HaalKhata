# Copy to .env next to docker-compose.yml. Used by `docker compose up`.

# Postgres password for the bundled db service (also baked into the web
# service's DATABASE_URL). Change it before first boot — the value is stored
# in the db volume on initialization.
POSTGRES_PASSWORD=change-me

# REQUIRED in production: session signing secret (any long random string,
# e.g. `openssl rand -hex 32`). If unset, sessions reset on every restart.
SESSION_SECRET=

# --- AI receipt parsing (all optional; mock provider always works) --------
# Comma-separated failover order. Available: local, anthropic, mock
RECEIPT_AI_PROVIDERS=local,anthropic,mock
ANTHROPIC_API_KEY=
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=qwen2.5vl
