# Production reverse proxy. Lives at /srv/haalkhata/Caddyfile, mounted
# read-only into the caddy container by docker-compose.prod.yml.
#
# Caddy obtains and renews Let's Encrypt certificates automatically; nothing
# here needs a cron job or a renewal hook. Certificates live in the caddy-data
# volume — do not delete it casually or you will re-issue from scratch and can
# hit rate limits.

{
	# Let's Encrypt expiry and problem notices. Use an address you read.
	email {$ACME_EMAIL}
}

haalkhata.app, www.haalkhata.app {
	encode zstd gzip

	# Reject oversized bodies at the public edge before proxying them into the
	# 1 GB application host. The app independently enforces a 12 MiB decoded
	# Connect-message limit; this slightly larger wire cap leaves framing room.
	request_body {
		max_size 16MB
	}

	header {
		# .app is an HSTS-preloaded TLD, so browsers already refuse plain HTTP
		# here before any header of ours is read. This is belt and braces — and
		# deliberately WITHOUT the `preload` token, which is painful to reverse
		# and would buy nothing on a TLD that is already on the list.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# CSP, nosniff, clickjacking, referrer, and permissions protections are
		# emitted by next.config.ts so they survive nginx, Traefik, cloud-LB, and
		# direct deployments. HSTS remains here as a TLS-edge responsibility;
		# the app also emits it so alternate HTTPS frontends retain the baseline.

		-Server
	}

	reverse_proxy web:3000 {
		# SECURITY-CRITICAL. clientIp() reads the FIRST
		# comma-separated value of X-Forwarded-For, and Caddy by default
		# APPENDS the real peer to whatever the client sent. Without this
		# overwrite a caller supplies their own X-Forwarded-For, picks their
		# own rate-limit bucket, rotates it at will, and AUTH_RATE_LIMIT stops
		# meaning anything. docker-compose.prod.yml enables
		# TRUST_PROXY_HEADERS only alongside this overwrite.
		header_up X-Forwarded-For {remote_host}
		# X-Real-IP is the app's fallback when X-Forwarded-For is unusable.
		# Caddy never sets it, so strip whatever the client sent rather than
		# forward a header the app has been told to trust.
		header_up -X-Real-IP

		# Host is deliberately NOT rewritten: csrfGuard() compares the Origin
		# header's host against request.headers.host. Caddy preserves Host by
		# default. (nginx would need `proxy_set_header Host $host` or every
		# browser POST 403s.)
	}
}
