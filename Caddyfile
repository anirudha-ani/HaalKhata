# Production reverse proxy. Lives at /srv/haalkhata/Caddyfile, mounted
# read-only into the caddy container by docker-compose.prod.yml.
#
# Caddy obtains and renews Let's Encrypt certificates automatically; nothing
# here needs a cron job or a renewal hook. Certificates live in the caddy-data
# volume — do not delete it casually or you will re-issue from scratch and can
# hit rate limits.

{
	# Let's Encrypt expiry and problem notices. Use an address you read.
	email {$ACME_EMAIL}

	# A request body has a minute to arrive in full. Caddy passes bodies on as
	# they arrive, so one trickled in a byte at a time would otherwise hold a
	# connection to the app for as long as the sender likes. A receipt photo
	# is the largest legitimate body; the app gives it 60 s and everything
	# else 15 s (BODY_READ_TIMEOUT_MS), and clients give a receipt call 120 s.
	servers {
		timeouts {
			read_body 60s
		}
	}
}

# Everything both sites share, written once. The proxy block below carries a
# security-critical header overwrite; two copies of it would be two chances
# to change one and forget the other. The one argument is the largest
# request body the site accepts.
(haalkhata) {
	encode zstd gzip

	# Reject oversized bodies at the public edge before proxying them into the
	# 1 GB application host.
	request_body {
		max_size {args[0]}
	}

	header {
		# .app is an HSTS-preloaded TLD, so browsers already refuse plain HTTP
		# here before any header of ours is read. This is belt and braces — and
		# deliberately WITHOUT the `preload` token, which is painful to reverse
		# and would buy nothing on a TLD that is already on the list.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# CSP, nosniff, clickjacking, referrer, and permissions protections are
		# emitted by next.config.ts so they survive nginx, Traefik, cloud-LB, and
		# direct deployments. HSTS remains here as a TLS-edge responsibility;
		# the app also emits it so alternate HTTPS frontends retain the baseline.

		-Server
	}

	reverse_proxy web:3000 {
		# SECURITY-CRITICAL. clientIp() reads the FIRST
		# comma-separated value of X-Forwarded-For, and Caddy by default
		# APPENDS the real peer to whatever the client sent. Without this
		# overwrite a caller supplies their own X-Forwarded-For, picks their
		# own rate-limit bucket, rotates it at will, and AUTH_RATE_LIMIT stops
		# meaning anything. docker-compose.prod.yml enables
		# TRUST_PROXY_HEADERS only alongside this overwrite.
		header_up X-Forwarded-For {remote_host}
		# X-Real-IP is the app's fallback when X-Forwarded-For is unusable.
		# Caddy never sets it, so strip whatever the client sent rather than
		# forward a header the app has been told to trust.
		header_up -X-Real-IP

		# Host is deliberately NOT rewritten: csrfGuard() compares the Origin
		# header's host against request.headers.host. Caddy preserves Host by
		# default. (nginx would need `proxy_set_header Host $host` or every
		# browser POST 403s.)
	}
}

haalkhata.app {
	# The app independently enforces a 12 MiB decoded Connect-message limit
	# (receipt photos); this slightly larger wire cap leaves framing room.
	import haalkhata 16MB
}

# One address only. Apple sends people back to the address above, the session
# cookie belongs to one host, and the app claims links on that host alone. The
# same app on www signs nobody in, and Safari hides the "www." that would explain
# why, so www only ever leads here. The path comes along, so old links still work.
www.haalkhata.app {
	redir https://haalkhata.app{uri} permanent
}

# The operator's usage page. Same container as the app: it decides what to
# serve by the Host header, which Caddy passes through untouched, so this
# hostname reaches the admin page and its API and nothing else, and the
# app's hostnames reach neither (apps/web/src/config/adminSurface.ts).
#
# Needs a DNS record for admin.haalkhata.app pointing at this server before
# the stack starts with this file: Caddy requests the certificate on boot
# and keeps retrying while the name does not resolve here.
admin.haalkhata.app {
	# Nothing sent here is larger than a sign-in token.
	import haalkhata 64KB

	# For one person; keep it out of search results even if a link leaks.
	header X-Robots-Tag "noindex, nofollow"
}
