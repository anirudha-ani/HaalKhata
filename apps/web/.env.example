# Postgres connection. Default matches the compose db service
# (`docker compose up -d db` at the repo root).
DATABASE_URL=postgres://haalkhata:haalkhata@localhost:5432/haalkhata

# Session signing secret (any long random string). If unset, a dev secret is
# generated and persisted under data/.secret
SESSION_SECRET=

# --- AI receipt parsing -------------------------------------------------
# Comma-separated provider order. Available: anthropic, local, mock
# Production per plan: local,anthropic,mock   Development: anthropic,mock
RECEIPT_AI_PROVIDERS=anthropic,local,mock

# Cloud provider (Claude vision)
ANTHROPIC_API_KEY=

# Self-hosted vision box (OpenAI-compatible server, e.g. Ollama/vLLM behind a
# Cloudflare Tunnel). Example: https://ai.example.com/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=qwen2.5vl
