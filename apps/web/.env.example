# Postgres connection. Must match the POSTGRES_PASSWORD in the repo-root
# .env (used by `docker compose up db`). Default here uses the same
# `change-me` value as the root .env.example — change BOTH together before
# first boot. If the db-data volume already exists with a different password,
# run `./dev.sh --clean` to wipe it and reinitialize.
DATABASE_URL=postgres://haalkhata:change-me@localhost:5432/haalkhata

# Session signing secret (any long random string). If unset, a dev secret is
# generated and persisted under data/.secret
SESSION_SECRET=

# --- AI receipt parsing -------------------------------------------------
# Comma-separated provider order. Available: anthropic, local, mock
# Production per plan: local,anthropic,mock   Development: anthropic,mock
RECEIPT_AI_PROVIDERS=anthropic,local,mock

# Cloud provider (Claude vision)
ANTHROPIC_API_KEY=

# Self-hosted vision box (OpenAI-compatible server, e.g. Ollama/vLLM behind a
# Cloudflare Tunnel). Example: https://ai.example.com/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=qwen2.5vl
