{
  "name": "@haalkhata/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev --turbopack -H 127.0.0.1",
    "dev:webpack": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "dev:clean": "rm -rf .next && pnpm dev",
    "build": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "db:new": "node-pg-migrate create -m migrations --migration-file-language sql"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-next": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@haalkhata/protogen": "workspace:*",
    "@haalkhata/shared": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
    "google-auth-library": "^10.9.1",
    "heic-decode": "^2.1.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "next": "^15.5.24",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
