{
  "name": "@haalkhata/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev --turbopack -H 127.0.0.1",
    "dev:webpack": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "dev:clean": "rm -rf .next && pnpm dev",
    "build": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "db:down": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "db:new": "node-pg-migrate create -m migrations --migration-file-language sql"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-next": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@haalkhata/protogen": "workspace:*",
    "@haalkhata/shared": "workspace:*",
    "@tanstack/query-persist-client-core": "^5.101.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.90.5",
    "heic-convert": "^2.1.0",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.23.0",
    "next": "^15.3.4",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
