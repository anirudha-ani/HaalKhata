{
  "name": "haalkhata",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "gen": "buf generate",
    "proto:lint": "buf lint",
    "dev": "pnpm --filter @haalkhata/web dev",
    "dev:mobile": "pnpm --filter @haalkhata/mobile dev",
    "auth:check": "pnpm --filter @haalkhata/web auth:check",
    "setup:env": "node scripts/setup-env.mjs",
    "test:environment": "node --test scripts/environment.test.mjs scripts/setup/*.test.mjs scripts/dev-startup.test.mjs scripts/dev-native.test.mjs",
    "lint:mobile": "pnpm --filter @haalkhata/mobile lint",
    "typecheck:mobile": "pnpm --filter @haalkhata/mobile typecheck",
    "test:mobile": "pnpm --filter @haalkhata/mobile test",
    "lint:shared": "pnpm --filter @haalkhata/shared lint",
    "typecheck:shared": "pnpm --filter @haalkhata/shared typecheck",
    "test:shared": "pnpm --filter @haalkhata/shared test",
    "build": "pnpm gen && pnpm --filter @haalkhata/web build",
    "start": "pnpm --filter @haalkhata/web start",
    "lint": "pnpm --filter @haalkhata/web lint",
    "test": "pnpm --filter @haalkhata/web test",
    "typecheck": "pnpm --filter @haalkhata/web typecheck",
    "db:migrate": "pnpm --filter @haalkhata/web db:migrate",
    "db:new": "pnpm --filter @haalkhata/web db:new",
    "db:seed": "pnpm --filter @haalkhata/web db:seed",
    "doctor": "pnpm exec react-doctor apps/web/src --no-telemetry --no-supply-chain",
    "test:security-patches": "node --test scripts/security-patches.test.cjs",
    "test:deploy": "node --test ops/deploy.test.cjs",
    "audit:production": "node scripts/audit-production.cjs",
    "test:parity": "node --test scripts/client-parity.test.cjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "braces": "3.0.3",
    "node-forge": "1.4.0",
    "react-doctor": "0.9.18"
  },
  "engines": {
    "node": ">=24"
  }
}
