{
  "name": "@haalkhata/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-written TypeScript shared by apps/web and apps/mobile (query keys, money helpers, greeting). Pure TS only — no React, React Native, DOM or Node APIs.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "currency-codes": "^2.2.0",
    "currency-symbol-map": "^5.1.0",
    "libphonenumber-js": "^1.13.14"
  }
}
