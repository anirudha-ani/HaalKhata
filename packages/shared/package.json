    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "currency-codes": "^2.2.0",
    "currency-symbol-map": "^5.1.0",
    "libphonenumber-js": "^1.13.8"
  }
}
