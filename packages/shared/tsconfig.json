{
  "compilerOptions": {
    "target": "ES2022",
    // DOM for URLSearchParams and globalThis.crypto, which the browser and
    // Hermes both provide; nothing here may touch document or window.
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
